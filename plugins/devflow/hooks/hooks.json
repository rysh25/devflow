{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "--no-cache",
              "run",
              "--offline",
              "--no-project",
              "--no-config",
              "--no-python-downloads",
              "${CLAUDE_PLUGIN_ROOT}/scripts/devflow.py",
              "--host",
              "claude",
              "hook"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "--no-cache",
              "run",
              "--offline",
              "--no-project",
              "--no-config",
              "--no-python-downloads",
              "${CLAUDE_PLUGIN_ROOT}/scripts/devflow.py",
              "--host",
              "claude",
              "hook"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "--no-cache",
              "run",
              "--offline",
              "--no-project",
              "--no-config",
              "--no-python-downloads",
              "${CLAUDE_PLUGIN_ROOT}/scripts/devflow.py",
              "--host",
              "claude",
              "hook"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
